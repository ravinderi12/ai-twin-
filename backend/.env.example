# Application Configuration
APP_NAME="AI-Powered Cybersecurity Digital Twin"
APP_ENV=development
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="cyber-digital-twin-super-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL="sqlite:///./cyber_digital_twin.db"

# Scanner Controls & Safety
